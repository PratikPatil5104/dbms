Methodology / Procedure 
Step 1: Create the Customers table. 
CREATE TABLE Customers ( 
CustomerID INT PRIMARY KEY, 
CustomerName VARCHAR(50), 
City VARCHAR(50) 
); 
Step 2: Create the Orders table. 
CREATE TABLE Orders ( 
OrderID INT PRIMARY KEY, 
CustomerID INT, 
Product VARCHAR(50), 
Amount INT 
); 
Step 3: Insert sample records into the tables. 
INSERT INTO Customers VALUES 
(1,'Rahul','Pune'), 
(2,'Sneha','Mumbai'), 
(3,'Amit','Delhi'), 
(4,'Priya','Chennai'); 
INSERT INTO Orders VALUES 
(101,1,'Laptop',60000), 
(102,1,'Mouse',500), 
(103,2,'Mobile',20000), 
(104,5,'Tablet',15000); 
Step 4: Retrieve customer orders using INNER JOIN. 
SELECT Customers.CustomerName, Orders.OrderID, Orders.Product 
FROM Customers 
INNER JOIN Orders 
ON Customers.CustomerID = Orders.CustomerID; 
Step 5: Retrieve all customers using LEFT JOIN. 
SELECT Customers.CustomerName, Orders.OrderID 
FROM Customers 
LEFT JOIN Orders 
ON Customers.CustomerID = Orders.CustomerID; 
Step 6: Retrieve all orders using RIGHT JOIN. 
SELECT Customers.CustomerName, Orders.OrderID 
FROM Customers 
RIGHT JOIN Orders 
ON Customers.CustomerID = Orders.CustomerID; 
Step 7: Retrieve complete records using FULL OUTER JOIN. 
SELECT Customers.CustomerName, Orders.OrderID 
FROM Customers 
FULL OUTER JOIN Orders 
ON Customers.CustomerID = Orders.CustomerID; 
