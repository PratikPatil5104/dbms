Employees Table 
Processor: 
1.Create Employees table 
CREATE TABLE Employees( 
emp_id NUMBER PRIMARY KEY, 
emp_name VARCHAR2(100), 
department VARCHAR2(50), 
salary NUMBER 
); 
2.CREATE Employee_Audit 
CREATE TABLE Employee_Audit ( 
audit_id NUMBER PRIMARY KEY, 
emp_id NUMBER, 
action VARCHAR2(10), 
old_salary NUMBER, 
new_salary NUMBER, 
action_date DATE 
); 
3.Create sequence of Employee_Audit 
CREATE SEQUENCE emp_audit_seq 
START WITH 1 
INCREMENT BY 1; 
4. Create Trigger on Employees 
CREATE OR REPLACE TRIGGER emp_audit_trigger 
AFTER INSERT OR UPDATE OR DELETE ON Employees 
FOR EACH ROW 
BEGIN 
IF INSERTING THEN 
INSERT INTO Employee_Audit 
VALUES(emp_audit_seq.NEXTVAL, :NEW.emp_id, ‘INSERT’, NULL, :NEW.salary, 
SYSDATE); 
ELSIF UPDATING THEN 
INSERT INTO Employee_Audit 
VALUES(emp_audit_seq.NEXTVAL, :NEW.emp_id, ‘UPDATE’,:OLD.salary, :NEW.salary, 
SYSDATE); 
ELSIF DELETING THEN 
INSERT INTO Employee_Audit 
VALUES(emp_audit_seq.NEXTVAL, :OLD.emp_id ,’ DELETE&’, :OLD.salary, NULL, 
SYSDATE); 
END IF; 
END; 
